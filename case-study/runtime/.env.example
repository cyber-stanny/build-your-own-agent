# 复制成 .env（.env 已被 gitignore，不会进库）
# runtime/config.ts 会统一读取这些配置

# 你的 DeepSeek key：web 端输对密码后用它对话
DEEPSEEK_API_KEY=your_deepseek_api_key
# 默认 DeepSeek 模型；需要临时切换时可在服务器 .env 里覆盖
DEEPSEEK_MODEL=deepseek-v4-pro

# 解锁口令：不配置就不能解锁真实模型
WEB_PASSWORD=change-me

# WebSocket 服务
PORT=8787

# Agent 默认参数
AGENT_CWD=./workspace
# 服务器部署建议设为 readonly-root，并安装 bubblewrap(bwrap)：根文件系统只读，仅 AGENT_CWD 可写
AGENT_SHELL_SANDBOX=off
MEMORY_FILE=memory/state.json
AGENT_MAX_TURNS=32
# cache-first：预算内完整历史只追加；legacy-window：旧的最近 N 轮滑动窗口
AGENT_CONTEXT_STRATEGY=cache-first
# cache-first 超预算后成批移除完整 user turn，避免每次请求都移动上下文起点
AGENT_CONTEXT_PRUNE_BATCH_USER_TURNS=8
# 仅 legacy-window 使用
AGENT_RECENT_TURNS=32
AGENT_MODEL_CONTEXT_TOKENS=1000000
AGENT_MAX_CONTEXT_TOKENS=500000
AGENT_MAX_TOOL_RESULT_CHARS=12000
AGENT_MAX_OUTPUT_TOKENS=16384
AGENT_COMPACT_KEEP_RECENT_USER_TURNS=2
# AGENT_SYSTEM_PROMPT=你是一个 coding agent。可以调用提供的工具读写文件、执行命令来完成任务。

# PR Codex Review 自动跟进（个人版）
PR_REVIEW_FOLLOWUP_ENABLED=true
PR_REVIEW_FOLLOWUP_INTERVAL_MS=60000
PR_REVIEW_FOLLOWUP_REVIEW_TIMEOUT_MS=1200000
PR_REVIEW_FOLLOWUP_CI_TIMEOUT_MS=1800000
# 默认写入 AGENT_CWD/.agent-runtime/pr-review-followups.json
# PR_REVIEW_FOLLOWUP_FILE=

# 登录 token：默认 7 天；AUTH_SECRET 不设时使用 WEB_PASSWORD
AUTH_SECRET=change-me-too
AUTH_TOKEN_TTL_MS=604800000

# DeepSeek 调试日志
DEEPSEEK_DEBUG_LOG=1
DEEPSEEK_DEBUG_LOG_DIR=model-logs
# SQLite 会话库：保存 transcript（续聊）和 timeline（历史展示）
SESSION_DB_FILE=sessions/sessions.db
# 无连接、无运行、无待审批的 SessionRuntime 空闲多久后从内存驱逐（默认 10 分钟）
SESSION_RUNTIME_IDLE_TTL_MS=600000

# 硅基流动 API（用于 analyzeImage 多模态图片理解）
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct
